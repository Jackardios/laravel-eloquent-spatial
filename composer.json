{
    "name": "jackardios/laravel-eloquent-spatial",
    "description": "Spatial library for Laravel",
    "homepage": "https://github.com/jackardios/laravel-eloquent-spatial",
    "license": "MIT",
    "authors": [
        {
            "name": "Matan Yadaev",
            "email": "matan.yed@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "brick/geo": "^0.13.1",
        "laravel/framework": "^12.18|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.1",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.1|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jackardios\\EloquentSpatial\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jackardios\\EloquentSpatial\\Tests\\": "tests"
        }
    },
    "scripts": {
        "pint": "pint",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "pest:mysql": [
            "@putenv DB_CONNECTION=mysql",
            "@putenv DB_PORT=3307",
            "@putenv DB_COLLATION=utf8mb4_unicode_ci",
            "pest"
        ],
        "pest:mariadb": [
            "@putenv DB_CONNECTION=mariadb",
            "@putenv DB_PORT=3308",
            "pest"
        ],
        "pest:postgres": [
            "@putenv DB_CONNECTION=pgsql",
            "@putenv DB_PORT=5433",
            "pest"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
