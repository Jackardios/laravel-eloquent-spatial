{
    "name": "jackardios/laravel-eloquent-spatial",
    "description": "Spatial library for Laravel",
    "homepage": "https://github.com/jackardios/laravel-eloquent-spatial",
    "license": "MIT",
    "authors": [
        {
            "name": "Matan Yadaev",
            "email": "matan.yed@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "phayes/geophp": "^1.2"
    },
    "require-dev": {
        "doctrine/dbal": "^3.5.3|^4.2",
        "larastan/larastan": "^2.9.7|^3.1",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.1|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jackardios\\EloquentSpatial\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jackardios\\EloquentSpatial\\Tests\\": "tests"
        }
    },
    "scripts": {
        "pint": "pint",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "pest:mysql": [
            "@putenv DB_CONNECTION=mysql",
            "@putenv DB_PORT=3307",
            "@putenv DB_COLLATION=utf8mb4_unicode_ci",
            "pest"
        ],
        "pest:mariadb": [
            "@putenv DB_CONNECTION=mariadb",
            "@putenv DB_PORT=3308",
            "pest"
        ],
        "pest:postgres": [
            "@putenv DB_CONNECTION=pgsql",
            "@putenv DB_PORT=5433",
            "pest"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jackardios\\EloquentSpatial\\EloquentSpatialServiceProvider"
            ]
        }
    }
}
