includes:
  - ./vendor/larastan/larastan/extension.neon
parameters:
  paths:
    - src
    - tests
  excludePaths:
    - tests/database
  ignoreErrors:
    -
      message: '#(Undefined variable: \$this|toBeInstanceOf\(\) expects class-string)#'
      path: tests/Expectations.php
    -
      message: '#Call to an undefined method Pest\\Expectation\<.+\>\:\:toBe(InstanceOf)?On(Postgres|Mysql)\(\)#'
      path: tests/*.php
    -
      # Laravel 13 types raw SQL parameters as literal-string; these expressions are built from wrapped identifiers and generated WKT.
      message: '#expects .*literal-string#'
      paths:
        - src/Traits/HasSpatial.php
        - src/Objects/Geometry.php
        - tests/*.php
    -
      identifier: missingType.generics
    -
      identifier: method.nonObject
    -
      identifier: varTag.nativeType

  level: max
  # The analysed stack differs between the lowest (Laravel 12) and highest (Laravel 13) supported versions.
  reportUnmatchedIgnoredErrors: false
